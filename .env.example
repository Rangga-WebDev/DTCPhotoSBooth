# Salin menjadi .env.local lalu isi sesuai cara booth dijalankan.
# Restart server setelah mengubah nilainya.

# ---------------------------------------------------------------
# Mode alamat QR: local | public | site
#   local  = HP satu Wi-Fi dengan laptop booth
#   public = laptop booth + tunnel HTTPS (Cloudflare Tunnel, dsb.)
#   site   = website di-deploy (Vercel). Default otomatis di Vercel.
# ---------------------------------------------------------------
NEXT_PUBLIC_DOWNLOAD_MODE=local

# Mode local: IPv4 laptop booth di Wi-Fi acara (cek dengan ipconfig), bukan localhost.
NEXT_PUBLIC_LOCAL_URL=http://192.168.1.10:3000

# Mode public: origin HTTPS tunnel yang meneruskan ke http://localhost:3000.
# NEXT_PUBLIC_PUBLIC_URL=https://booth.example.com

# Mode site: domain website. Kosongkan untuk memakai domain yang sedang dibuka.
# Di Vercel isi domain produksi supaya QR tidak memakai URL deployment yang dilindungi login.
# NEXT_PUBLIC_SITE_URL=https://cia-photobooth.vercel.app

# ---------------------------------------------------------------
# Penyimpanan foto hasil (untuk QR)
#   Tanpa token  → folder storage/photos di laptop (mode local/public).
#   Dengan token → Vercel Blob (wajib saat deploy di Vercel).
#   Di Vercel kredensial ini (BLOB_STORE_ID/OIDC + token) terisi otomatis
#   saat Blob store dihubungkan ke project.
# ---------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Akses Blob store: private (disarankan) atau public, sesuai saat store dibuat.
# BLOB_ACCESS=private

# Kunci upload booth. Wajib untuk website publik (mode site): tanpa kunci, upload ditolak.
# Setelah diisi, buka /?key=KUNCI sekali di laptop booth.
# BOOTH_ACCESS_KEY=ganti-dengan-kunci-acak

# Rahasia untuk cron pembersih foto kedaluwarsa (/api/cleanup).
# CRON_SECRET=ganti-dengan-rahasia-acak
